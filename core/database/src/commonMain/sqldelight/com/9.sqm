-- v9 -> v10: local profiles (task 59). Purely additive: one new table, no existing table or
-- row touched. Every user-data table already carries profile_id and all existing rows live
-- under "default", which this seeds as the first profile ("Me", avatar 0). Must match the
-- profile DDL in Profiles.sq.
CREATE TABLE profile (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    avatar INTEGER NOT NULL DEFAULT 0,
    is_kids INTEGER NOT NULL DEFAULT 0,
    sort INTEGER NOT NULL DEFAULT 0,
    created_ms INTEGER NOT NULL DEFAULT 0
);
INSERT INTO profile(id, name, avatar, is_kids, sort, created_ms) VALUES ('default', 'Me', 0, 0, 0, 0);
