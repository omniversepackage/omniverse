FROM series v
LEFT JOIN item_override o ON o.profile_id = :profileId AND o.source_id = v.source_id AND o.kind = 'SERIES' AND o.remote_id = v.remote_id
LEFT JOIN title_override t ON t.profile_id = :profileId AND t.content_kind = 'SERIES' AND t.id_namespace = 'tmdb' AND t.external_id = v.tmdb_id
